# Model access, for the signal-evaluation and outreach steps.
#
# These are only a fallback: whatever is saved under Settings -> Model in the
# dashboard wins, so the sales team can change model without a redeploy. Set
# them here if you would rather keep the key out of the database entirely.
#
# Any OpenAI-compatible gateway works. AgentRouter (default) fronts Anthropic,
# OpenAI, DeepSeek and others behind one key; get one at
# https://agentrouter.org/console/token
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=sk-...
SIGNAL_MODEL=claude-opus-5

# Other gateways, for reference:
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1        SIGNAL_MODEL=gpt-5
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1     SIGNAL_MODEL=anthropic/claude-opus-5
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1   SIGNAL_MODEL=openai/gpt-oss-120b
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1        SIGNAL_MODEL=llama3.1

# How much evidence text one evaluation call may carry, in characters - roughly
# four characters to the token. The default suits a large context window; a
# rate-limited tier needs less. Groq's free tier allows 8k tokens per minute,
# which fits a budget of about 20000. Also settable per run: --budget 20000
# EVIDENCE_CHAR_BUDGET=240000

# Encrypts the API key before it is written to the database. If this is unset a
# random secret is generated and stored alongside the ciphertext, which still
# beats plaintext but is weaker - set a long random value here in production.
APP_SECRET=

# Postgres. Supabase free plan (recommended) or any Postgres 14+ instance.
#
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler".
# Use the pooler (port 6543), not "Direct connection" (port 5432) - on the free plan the
# direct host is IPv6-only and will time out on most home/office networks. Transaction
# mode is fine here since nothing in this app holds a session across multiple queries.
# The password in the string is the database password you set when creating the project,
# not an API key from Project Settings -> API.
DATABASE_URL=postgres://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Local Docker Postgres instead (npm run db:up):
# DATABASE_URL=postgres://orange:orange@localhost:5433/orange_signal

# Identify your crawler honestly. Put a real contact address here.
CRAWLER_USER_AGENT=OrangeSignalBot/0.1 (+mailto:sales-eng@orange-systems.example)
CRAWLER_CONCURRENCY=4
CRAWLER_DELAY_MS=1200
RESPECT_ROBOTS=true

# Optional paid/keyed sources. Adapters are skipped when the key is absent.
NEWSAPI_KEY=
CRUNCHBASE_API_KEY=

API_PORT=8080
